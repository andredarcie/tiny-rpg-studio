{
  "name": "tiny-rpg-studio-sdk",
  "version": "2.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/andredarcie/tiny-rpg-studio"
  },
  "files": [
    "dist/sdk",
    "public/export.bundle.js",
    "public/tiny-rpg-studio-sdk.css",
    "public/pixel-operator.woff",
    "SDK_README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/sdk/sdk/index.d.ts",
        "default": "./dist/sdk/index.js"
      },
      "require": {
        "types": "./dist/sdk/sdk/index.d.cts",
        "default": "./dist/sdk/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/sdk/sdk/browser.d.ts",
        "default": "./dist/sdk/browser.js"
      },
      "require": {
        "types": "./dist/sdk/sdk/browser.d.cts",
        "default": "./dist/sdk/browser.cjs"
      }
    },
    "./html": {
      "import": {
        "types": "./dist/sdk/sdk/html.d.ts",
        "default": "./dist/sdk/html.js"
      },
      "require": {
        "types": "./dist/sdk/sdk/html.d.cts",
        "default": "./dist/sdk/html.cjs"
      }
    },
    "./runtime.js": "./public/export.bundle.js",
    "./styles.css": "./public/tiny-rpg-studio-sdk.css",
    "./font.woff": "./public/pixel-operator.woff"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:export && vite build",
    "build:desktop": "npm run build && tauri build",
    "tauri": "tauri",
    "build:check": "tsc --noEmit && npm run build",
    "build:export": "vite build -c vite.export.config.ts",
    "measure:export": "npm run build:export && node scripts/report-export-sizes.mjs",
    "build:sdk": "vite build -c vite.sdk.config.ts && tsc -p tsconfig.sdk.json && node scripts/finalize-sdk-types.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "fonteditor-core": "^2.6.3",
    "jsdom": "^24.1.0",
    "partykit": "^0.0.115",
    "partysocket": "^1.1.19",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "types": "./dist/sdk/sdk/index.d.ts"
}
